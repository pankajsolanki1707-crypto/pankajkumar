# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://pankajkumar.com
CLIENT_URL=https://pankajkumar.com

# Security Secrets (Must be generated using high-entropy crypto.randomBytes)
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
CSRF_SECRET=your_csrf_secret_key_here
DOWNLOAD_TOKEN_SECRET=your_download_signature_secret_here

# Cashfree Credentials (INR Payments for India)
CASHFREE_APP_ID=122857654c7913872b1af1e92176758221
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=PRODUCTION

# PayPal Business Credentials (USD Payments for Global/International)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET_KEY=your_paypal_secret_key
PAYPAL_ENVIRONMENT=PRODUCTION

# Security Policies
MAX_AUTH_ATTEMPTS=5
LOCKOUT_DURATION_MINS=15
SIGNED_URL_EXPIRY_MINS=60
